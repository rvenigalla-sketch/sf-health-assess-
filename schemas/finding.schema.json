{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShardReview",
  "description": "Output of one reviewer agent for one shard. Every finding must cite exact source lines.",
  "type": "object",
  "additionalProperties": false,
  "required": ["shard_id", "findings", "coverage", "follow_up"],
  "properties": {
    "shard_id": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title", "area", "category", "severity", "component", "evidence", "evidence_ids",
          "basis", "confidence", "impact", "recommendation", "effort", "related_components"
        ],
        "properties": {
          "title": { "type": "string", "maxLength": 140 },
          "area": { "enum": ["apex", "flow", "automation", "security", "datamodel", "crma", "integration", "release"] },
          "category": {
            "enum": [
              "bulkification", "error-handling", "security", "performance", "maintainability",
              "automation-overlap", "data-model", "test-quality", "release-readiness", "crma", "integration"
            ]
          },
          "severity": { "enum": ["Critical", "High", "Medium", "Low"] },
          "component": { "type": "string", "description": "Inventory id, e.g. ApexClass:AccountTriggerHelper or Flow:Update_Bid_Status" },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "line_start", "line_end", "quote"],
              "properties": {
                "path": { "type": "string", "description": "Run-relative path exactly as given in the shard (source file or flow digest)" },
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 },
                "quote": { "type": "string", "minLength": 3, "maxLength": 500, "description": "Exact text copied from those lines" }
              }
            }
          },
          "evidence_ids": { "type": "array", "items": { "type": "string" }, "description": "Tool evidence ids from the shard (e.g. CA-00123); empty if none" },
          "basis": { "enum": ["tool-confirmed", "llm-observation"] },
          "confidence": { "enum": ["high", "medium", "low"] },
          "impact": { "type": "string", "maxLength": 400 },
          "recommendation": { "type": "string", "maxLength": 500 },
          "effort": { "enum": ["S", "M", "L"] },
          "related_components": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components_reviewed", "skipped"],
      "properties": {
        "components_reviewed": { "type": "array", "items": { "type": "string" } },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "reason"],
            "properties": { "component": { "type": "string" }, "reason": { "type": "string" } }
          }
        }
      }
    },
    "follow_up": {
      "type": "array",
      "maxItems": 5,
      "description": "Cross-component leads outside this shard worth a targeted second look",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "reason"],
        "properties": { "component": { "type": "string" }, "reason": { "type": "string" } }
      }
    }
  }
}
