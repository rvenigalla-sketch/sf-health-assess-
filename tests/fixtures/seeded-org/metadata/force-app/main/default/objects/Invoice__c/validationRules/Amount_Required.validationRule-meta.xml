<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Amount_Required</fullName>
    <active>true</active>
    <errorConditionFormula>ISBLANK(Amount__c) &amp;&amp; ISPICKVAL(Status__c, 'Approved') &amp;&amp; AmountTotal__c != ''</errorConditionFormula>
    <errorMessage>Amount is required</errorMessage>
</ValidationRule>
